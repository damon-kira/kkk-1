<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lxmlns="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    lxmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_aiv"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/image_home_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/inclue_demo_layout_0"
            style="@style/marginLeftAndRight16"
            layout="@layout/layout_demo_entrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent" />
        <include
            android:id="@+id/inclue_demo_layout_1"
            style="@style/marginLeftAndRight16"
            layout="@layout/layout_demo_entrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/inclue_demo_layout_0" />

        <include
            android:id="@+id/inclue_demo_layout_2"
            style="@style/marginLeftAndRight16"
            layout="@layout/layout_demo_entrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/inclue_demo_layout_1" />

        <include
            android:id="@+id/inclue_demo_layout_3"
            style="@style/marginLeftAndRight16"
            layout="@layout/layout_demo_entrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/inclue_demo_layout_2" />

        <include
            android:id="@+id/inclue_demo_layout_4"
            style="@style/marginLeftAndRight16"
            layout="@layout/layout_demo_entrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/inclue_demo_layout_3" />


        <!--        <include-->
        <!--            android:id="@+id/include_black"-->
        <!--            style="@style/marginLeftAndRight16"-->
