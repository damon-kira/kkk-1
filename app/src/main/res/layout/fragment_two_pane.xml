<?xml version="1.0" encoding="utf-8"?>


<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/drawer_layout">

        <androidx.fragment.app.FragmentContainerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/fragment_editor"
            android:name="com.kira.ui.feature.editor.ui.fragment.EditorFragment"
            tools:layout="@layout/fragment_editor" />

        <androidx.fragment.app.FragmentContainerView
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:id="@+id/fragment_explorer"
            android:name="com.kira.ui.feature.explorer.ui.fragment.ExplorerFragment"
            tools:layout="@layout/fragment_explorer" />

    </androidx.drawerlayout.widget.DrawerLayout>

</FrameLayout>