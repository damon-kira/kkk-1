        app:verticalPanEnabled="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.kira.richtext.FlexibleRichTextView
                android:id="@+id/ftText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </FrameLayout>
