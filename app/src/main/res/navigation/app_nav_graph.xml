<?xml version="1.0" encoding="utf-8"?>


<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_nav_graph"
    app:startDestination="@id/twoPaneFragment">

    <fragment
        android:id="@+id/twoPaneFragment"
        android:name="com.kira.learning.module.supereditor.TwoPaneFragment"
        tools:layout="@layout/fragment_two_pane" >
        <action
            android:id="@+id/to_confirmExitDialog"
            app:destination="@id/confirmExitDialog" />
    </fragment>

    <dialog
        android:id="@+id/confirmExitDialog"
        android:name="com.kira.learning.dialog.ConfirmExitDialog"
        android:label="@string/pref_confirm_exit_title">
        <deepLink app:uri="kiralearning://exit" />
    </dialog>

    <include
        android:id="@+id/editor_graph"
        app:graph="@navigation/editor_graph" />

    <include
        android:id="@+id/explorer_graph"
        app:graph="@navigation/explorer_graph" />

    <include
        android:id="@+id/settings_graph"
        app:graph="@navigation/settings_graph" />

    <include
        android:id="@+id/fonts_graph"
        app:graph="@navigation/fonts_graph" />

    <include
        android:id="@+id/themes_graph"
        app:graph="@navigation/themes_graph" />

    <include
        android:id="@+id/servers_graph"
        app:graph="@navigation/servers_graph" />

    <include
        android:id="@+id/shortcuts_graph"
        app:graph="@navigation/shortcuts_graph" />

    <include
        android:id="@+id/changelog_graph"
        app:graph="@navigation/changelog_graph" />

</navigation>